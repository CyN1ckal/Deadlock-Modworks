#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "@SR_PRODUCT_NAME@ @PROJECT_VERSION@"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "@SR_PRODUCT_EXECUTABLE@"
            VALUE "OriginalFilename", "@SR_PRODUCT_EXECUTABLE@.exe"
            VALUE "ProductName", "@SR_PRODUCT_NAME@"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "Comments", "build @SR_GIT_COMMIT@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
