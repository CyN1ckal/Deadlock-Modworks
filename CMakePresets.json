{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows Debug x64",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/debug"
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release x64",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/release"
    },
    {
      "name": "clion-debug",
      "displayName": "CLion Debug x64",
      "description": "Full model tools app with Ninja and the CLion Visual Studio toolchain.",
      "generator": "Ninja",
      "architecture": { "value": "x64", "strategy": "external" },
      "binaryDir": "${sourceDir}/build/clion-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "SR_BUILD_MODEL_TOOLS": true,
        "SR_TRACY": false
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "vendor": { "jetbrains.com/clion": { "toolchain": "Visual Studio" } }
    },
    {
      "name": "clion-release",
      "displayName": "CLion Release x64",
      "description": "Full model tools app optimized for release with Ninja and the CLion Visual Studio toolchain.",
      "inherits": "clion-debug",
      "binaryDir": "${sourceDir}/build/clion-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "clion-profile",
      "displayName": "CLion Profile x64",
      "description": "Optimized model tools with debug symbols and Tracy. Connect a profiler to localhost while the window is open.",
      "inherits": "clion-debug",
      "binaryDir": "${sourceDir}/build/clion-profile",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SR_TRACY": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release"
    },
    {
      "name": "clion-debug",
      "configurePreset": "clion-debug"
    },
    {
      "name": "clion-release",
      "configurePreset": "clion-release"
    },
    {
      "name": "clion-profile",
      "configurePreset": "clion-profile"
    }
  ]
}
